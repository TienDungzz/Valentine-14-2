{
  "name": "valentine-red",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Valentine Red — Hai nửa, một tình yêu",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node scripts/check-project.mjs --run",
    "check:static": "node scripts/check-project.mjs",
    "check:config": "node scripts/check-config.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:css": "node scripts/check-css.mjs",
    "check:quality": "node scripts/check-quality.mjs --run",
    "check:format": "node scripts/check-valentine.mjs format",
    "check:content": "node scripts/check-valentine.mjs content",
    "check:code": "node scripts/check-valentine.mjs code",
    "check:characters": "node scripts/check-character-assets.mjs",
    "check:gltf": "node scripts/check-gltf.mjs",
    "lint": "eslint . --max-warnings 0",
    "unused": "knip",
    "test": "node --test tests/*.test.mjs",
    "assets:optimize": "node scripts/optimize-characters.mjs",
    "qa:geometry": "node scripts/preview-geometry.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "audit": "npm audit --audit-level=high",
    "test:tools": "node --test tests/tooling/*.test.mjs",
    "check:blender": "node scripts/check-python.mjs"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@xmldom/xmldom": "0.9.12",
    "eslint": "10.14.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "knip": "6.45.0",
    "meshoptimizer": "1.2.0",
    "postcss": "8.5.32",
    "postcss-value-parser": "4.2.0",
    "sharp": "0.35.5",
    "vite": "8.3.6"
  }
}
